{
    "name": "lattice-php/media",
    "description": "First-party media library for Lattice.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "intervention/image": "^4.0",
        "lattice-php/lattice": "^0.40"
    },
    "require-dev": {
        "bambamboole/extended-testbench": "^0.6",
        "bambamboole/laravel-i18next": "^0.6.0",
        "larastan/larastan": "^3.0",
        "laravel/boost": "^2.4",
        "laravel/pint": "^1.16",
        "league/flysystem-aws-s3-v3": "^3.34",
        "pestphp/pest": "^5.0",
        "pestphp/pest-plugin-browser": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Lattice\\Media\\": "src/",
            "Lattice\\Media\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lattice\\Media\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "extra": {
        "extended-testbench": {
            "check-ignore": [
                "tests/Browser/DummyTest.php",
                "rector.php"
            ]
        },
        "lattice": {
            "plugin": "resources/js/plugin.ts",
            "discover": [
                "src"
            ]
        },
        "laravel": {
            "providers": [
                "Lattice\\Media\\MediaServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:purge-skeleton --ansi",
            "@php vendor/bin/testbench package:discover --ansi"
        ],
        "post-install-cmd": [
            "@boost:refresh"
        ],
        "post-update-cmd": [
            "@boost:refresh"
        ],
        "boost:refresh": "[ -n \"$CI\" ] || [ ! -f vendor/bin/testbench ] || [ ! -f boost.json ] || { [ -f package.json ] && [ ! -d node_modules ]; } || vendor/bin/testbench boost:update --no-interaction || true",
        "serve": "@php vendor/bin/testbench serve",
        "test": "pest --exclude-testsuite=Browser",
        "test:browser": [
            "npm run build",
            "pest --testsuite=Browser"
        ],
        "lint": "pint --format agent",
        "stan": "phpstan analyse",
        "refactor": "rector",
        "check": [
            "pint --test",
            "phpstan analyse",
            "rector --dry-run",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}